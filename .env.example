# .env.example — copy to .env.local and fill in real values.
# The real .env.local is gitignored: never commit it. Keep secrets out of code.

# --- Core ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Auth, Postgres, Storage) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only, never exposed to the browser — used for admin/service tasks only
SUPABASE_SERVICE_ROLE_KEY=

# --- HubSpot (contact upsert + timeline event on package send) ---
# Named SECURAFY_-prefixed, not the generic HUBSPOT_PRIVATE_APP_TOKEN, to
# avoid colliding with an unrelated env var of that generic name some
# machines may already have set for a different project.
SECURAFY_HUBSPOT_TOKEN=

# --- Vimeo (video/audio hosting) ---
VIMEO_ACCESS_TOKEN=

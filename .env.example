# .env.example — copy to .env and fill in real values.
# The real .env is gitignored: never commit it. Keep secrets out of code.
# Each var below is a placeholder — replace the empty value, don't add quotes.

# --- Core ---
APP_ENV=development

# --- Secrets (fill locally, never commit) ---
API_KEY=
DATABASE_URL=

# --- Optional / service-specific ---
# ANTHROPIC_API_KEY=
# PORT=8000

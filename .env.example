# .env.example — copy to .env.local and fill in real values.
# The real .env.local is gitignored: never commit it. Keep secrets out of code.

# --- Core ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Auth, Postgres, Storage) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only, never exposed to the browser — used for admin/service tasks only
SUPABASE_SERVICE_ROLE_KEY=

# --- HubSpot (contact upsert + timeline event on package send) ---
# Named SECURAFY_-prefixed, not the generic HUBSPOT_PRIVATE_APP_TOKEN, to
# avoid colliding with an unrelated env var of that generic name some
# machines may already have set for a different project.
SECURAFY_HUBSPOT_TOKEN=

# --- Vimeo (video/audio hosting) ---
# Reserved for a future API-based integration -- reps currently paste
# public/unlisted Vimeo URLs directly, so no code reads this today.
VIMEO_ACCESS_TOKEN=

# --- Vercel AI Gateway (Claude API via Vercel) ---
AI_GATEWAY_API_KEY=

# --- Gate Desk (Actiforge's campaign backend, server-to-server package
# creation via POST /api/packages) --- a long random shared secret, not a
# real API key from a provider. See spec/plan.md T33.
GATE_DESK_API_KEY=

# --- Resend (T36 "strike while hot" rep notification emails) ---
# Reuse the same Resend API key already used as the SMTP password in
# Supabase's Auth email settings (Project Settings -> Authentication ->
# Emails -> SMTP Settings), or generate a separate dedicated key from
# resend.com if you'd rather keep the two uses separate.
RESEND_API_KEY=
# Optional -- defaults to "ActiDesk <no-reply@mail.securafyai.com>" (the
# domain already verified for Supabase's own SMTP relay) if unset.
NOTIFICATIONS_FROM_EMAIL=

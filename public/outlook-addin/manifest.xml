<?xml version="1.0" encoding="UTF-8"?>
<!--
  ActiDesk for Outlook. Deploy from Microsoft 365 admin center -> Settings ->
  Integrated apps -> Upload custom apps -> "Provide link to manifest file":
  https://www.actidesk.ai/outlook-addin/manifest.xml
  Reps sign in with the Microsoft account they already use in Outlook; it
  must match the Outlook connection on their ActiDesk Account page.
-->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp">
  <Id>8177b920-f901-4a8b-899b-c75c92d630d5</Id>
  <Version>2.0.0.0</Version>
  <ProviderName>Securafy</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="ActiDesk" />
  <Description DefaultValue="Build, send, and track personalized ActiDesk prospect packages without leaving Outlook." />
  <IconUrl DefaultValue="https://www.actidesk.ai/outlook-addin/icon-64.png" />
  <HighResolutionIconUrl DefaultValue="https://www.actidesk.ai/outlook-addin/icon-128.png" />
  <SupportUrl DefaultValue="https://www.actidesk.ai/" />
  <AppDomains>
    <AppDomain>https://www.actidesk.ai</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox" />
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1" />
    </Sets>
  </Requirements>
  <!-- Only read by old Outlook clients that don't understand the ribbon
       buttons in VersionOverrides below. -->
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://www.actidesk.ai/outlook-addin/taskpane" />
        <RequestedHeight>450</RequestedHeight>
      </DesktopSettings>
    </Form>
    <Form xsi:type="ItemEdit">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://www.actidesk.ai/outlook-addin/taskpane" />
      </DesktopSettings>
    </Form>
  </FormSettings>
  <!-- Narrowest level that allows inserting the package link into the
       message being written. Never ReadWriteMailbox. -->
  <Permissions>ReadWriteItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read" />
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit" />
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.3">
        <bt:Set Name="Mailbox" />
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="actideskReadGroup">
                <Label resid="GroupLabel" />
                <Control xsi:type="Button" id="actideskReadButton">
                  <Label resid="ButtonLabel" />
                  <Supertip>
                    <Title resid="ButtonLabel" />
                    <Description resid="ButtonTooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon16" />
                    <bt:Image size="32" resid="Icon32" />
                    <bt:Image size="80" resid="Icon80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="TaskpaneUrl" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
          <ExtensionPoint xsi:type="MessageComposeCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="actideskComposeGroup">
                <Label resid="GroupLabel" />
                <Control xsi:type="Button" id="actideskComposeButton">
                  <Label resid="ButtonLabel" />
                  <Supertip>
                    <Title resid="ButtonLabel" />
                    <Description resid="ButtonTooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon16" />
                    <bt:Image size="32" resid="Icon32" />
                    <bt:Image size="80" resid="Icon80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="TaskpaneUrl" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon16" DefaultValue="https://www.actidesk.ai/outlook-addin/icon-16.png" />
        <bt:Image id="Icon32" DefaultValue="https://www.actidesk.ai/outlook-addin/icon-32.png" />
        <bt:Image id="Icon80" DefaultValue="https://www.actidesk.ai/outlook-addin/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="TaskpaneUrl" DefaultValue="https://www.actidesk.ai/outlook-addin/taskpane" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GroupLabel" DefaultValue="ActiDesk" />
        <bt:String id="ButtonLabel" DefaultValue="ActiDesk" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="ButtonTooltip" DefaultValue="Build and send a personalized ActiDesk package, and see who opened theirs." />
      </bt:LongStrings>
    </Resources>

    <!-- Same buttons, plus a pinnable taskpane (stays open while the rep
         moves between emails). Requires Mailbox 1.5. -->
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.5">
          <bt:Set Name="Mailbox" />
        </bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <DesktopFormFactor>
            <ExtensionPoint xsi:type="MessageReadCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="actideskReadGroup">
                  <Label resid="GroupLabel" />
                  <Control xsi:type="Button" id="actideskReadButton">
                    <Label resid="ButtonLabel" />
                    <Supertip>
                      <Title resid="ButtonLabel" />
                      <Description resid="ButtonTooltip" />
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon16" />
                      <bt:Image size="32" resid="Icon32" />
                      <bt:Image size="80" resid="Icon80" />
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="TaskpaneUrl" />
                      <SupportsPinning>true</SupportsPinning>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
            <ExtensionPoint xsi:type="MessageComposeCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="actideskComposeGroup">
                  <Label resid="GroupLabel" />
                  <Control xsi:type="Button" id="actideskComposeButton">
                    <Label resid="ButtonLabel" />
                    <Supertip>
                      <Title resid="ButtonLabel" />
                      <Description resid="ButtonTooltip" />
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon16" />
                      <bt:Image size="32" resid="Icon32" />
                      <bt:Image size="80" resid="Icon80" />
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="TaskpaneUrl" />
                      <SupportsPinning>true</SupportsPinning>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Images>
          <bt:Image id="Icon16" DefaultValue="https://www.actidesk.ai/outlook-addin/icon-16.png" />
          <bt:Image id="Icon32" DefaultValue="https://www.actidesk.ai/outlook-addin/icon-32.png" />
          <bt:Image id="Icon80" DefaultValue="https://www.actidesk.ai/outlook-addin/icon-80.png" />
        </bt:Images>
        <bt:Urls>
          <bt:Url id="TaskpaneUrl" DefaultValue="https://www.actidesk.ai/outlook-addin/taskpane" />
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="GroupLabel" DefaultValue="ActiDesk" />
          <bt:String id="ButtonLabel" DefaultValue="ActiDesk" />
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="ButtonTooltip" DefaultValue="Build and send a personalized ActiDesk package, and see who opened theirs." />
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
